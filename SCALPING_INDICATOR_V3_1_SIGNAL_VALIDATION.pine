//@version=6
indicator("Scalping M1 - Signal Validation", "Scalp V3.1", overlay=true, max_boxes_count=200, max_labels_count=500)

// ============================================================================
// PURPOSE
// - V3.1 = signal-validation build only.
// - Goal: validate H1 -> M15 -> M1 cascade visibility and alerts.
// - Trade-entry logic intentionally excluded: no Premium/Discount, no retracement,
//   no SL/TP, no BE, no add-in.
// ============================================================================

// ============================================================================
// CONFIG
// ============================================================================
show_debug = input.bool(true, "Show debug labels")
show_fvg = input.bool(true, "Show M1 FVG boxes")
one_signal_per_bar = input.bool(true, "One signal per bar")

// ============================================================================
// H1: CRT CONTEXT
// ============================================================================
h1_bullish_crt = request.security(syminfo.tickerid, "60", (close[1] < open[1]) and (close > open) and (close > low[1]) and (close < high[1]), lookahead=barmerge.lookahead_off)
h1_bearish_crt = request.security(syminfo.tickerid, "60", (close[1] > open[1]) and (close < open) and (close > low[1]) and (close < high[1]), lookahead=barmerge.lookahead_off)

// ============================================================================
// M15: STRUCTURAL FILTER
// ============================================================================
m15_swing_low = request.security(syminfo.tickerid, "15", (close[2] < open[2]) and (low[2] > low[1]) and (low[1] < low) and (close > open), lookahead=barmerge.lookahead_off)
m15_swing_high = request.security(syminfo.tickerid, "15", (close[2] > open[2]) and (high[2] < high[1]) and (high[1] > high) and (close < open), lookahead=barmerge.lookahead_off)

m15_bull_ok = h1_bullish_crt and m15_swing_low
m15_bear_ok = h1_bearish_crt and m15_swing_high

// ============================================================================
// M1: FVG DETECTION ONLY
// ============================================================================
fvg_bull = high[2] < low
fvg_bear = low[2] > high

fvg_bull_top = low
fvg_bull_bottom = high[2]
fvg_bear_top = low[2]
fvg_bear_bottom = high

// ============================================================================
// SIGNAL VALIDATION LOGIC
// - Intentional simplification: no price retracement filter.
// - BUY = H1 bullish CRT + M15 swing low + M1 bullish FVG.
// - SELL = H1 bearish CRT + M15 swing high + M1 bearish FVG.
// ============================================================================
buy_raw = m15_bull_ok and fvg_bull
sell_raw = m15_bear_ok and fvg_bear

buy_signal = one_signal_per_bar ? (buy_raw and not buy_raw[1]) : buy_raw
sell_signal = one_signal_per_bar ? (sell_raw and not sell_raw[1]) : sell_raw

// ============================================================================
// DISPLAY: FVG BOXES
// ============================================================================
if timeframe.period == "1" and show_fvg
    if fvg_bull
        box.new(bar_index - 2, fvg_bull_top, bar_index, fvg_bull_bottom, border_color=color.new(color.green, 0), bgcolor=color.new(color.green, 85), xloc=xloc.bar_index)
    if fvg_bear
        box.new(bar_index - 2, fvg_bear_top, bar_index, fvg_bear_bottom, border_color=color.new(color.red, 0), bgcolor=color.new(color.red, 85), xloc=xloc.bar_index)

// ============================================================================
// DISPLAY: DEBUG CASCADE
// ============================================================================
if show_debug
    if timeframe.period == "60"
        if h1_bullish_crt
            label.new(bar_index, low, "H1 CRT BULL", color=color.new(color.green, 0), textcolor=color.white, yloc=yloc.belowbar, size=size.small, style=label.style_label_up)
        if h1_bearish_crt
            label.new(bar_index, high, "H1 CRT BEAR", color=color.new(color.red, 0), textcolor=color.white, yloc=yloc.abovebar, size=size.small, style=label.style_label_down)

    if timeframe.period == "15"
        if m15_bull_ok
            label.new(bar_index, low, "H1+M15 BULL", color=color.new(color.green, 0), textcolor=color.white, yloc=yloc.belowbar, size=size.small, style=label.style_label_up)
        if m15_bear_ok
            label.new(bar_index, high, "H1+M15 BEAR", color=color.new(color.red, 0), textcolor=color.white, yloc=yloc.abovebar, size=size.small, style=label.style_label_down)

    if timeframe.period == "1"
        if h1_bullish_crt
            label.new(bar_index, high, "H1", color=color.new(color.green, 0), textcolor=color.white, yloc=yloc.abovebar, size=size.tiny, style=label.style_label_down)
        if h1_bearish_crt
            label.new(bar_index, high, "H1", color=color.new(color.red, 0), textcolor=color.white, yloc=yloc.abovebar, size=size.tiny, style=label.style_label_down)
        if m15_bull_ok
            label.new(bar_index, low, "M15", color=color.new(color.green, 0), textcolor=color.white, yloc=yloc.belowbar, size=size.tiny, style=label.style_label_up)
        if m15_bear_ok
            label.new(bar_index, low, "M15", color=color.new(color.red, 0), textcolor=color.white, yloc=yloc.belowbar, size=size.tiny, style=label.style_label_up)

// ============================================================================
// DISPLAY: FINAL SIGNALS + ALERTS
// ============================================================================
if timeframe.period == "1"
    if buy_signal
        label.new(bar_index, low, "BUY", color=color.new(color.green, 0), textcolor=color.white, yloc=yloc.belowbar, size=size.normal, style=label.style_diamond)
        alert("BUY SIGNAL | H1 CRT BULL + M15 SWING LOW + M1 FVG BULL", alert.freq_once_per_bar_close)

    if sell_signal
        label.new(bar_index, high, "SELL", color=color.new(color.red, 0), textcolor=color.white, yloc=yloc.abovebar, size=size.normal, style=label.style_diamond)
        alert("SELL SIGNAL | H1 CRT BEAR + M15 SWING HIGH + M1 FVG BEAR", alert.freq_once_per_bar_close)

// ============================================================================
// ALERT CONDITIONS
// ============================================================================
alertcondition(buy_signal, "BUY SIGNAL", "BUY SIGNAL | H1 CRT BULL + M15 SWING LOW + M1 FVG BULL")
alertcondition(sell_signal, "SELL SIGNAL", "SELL SIGNAL | H1 CRT BEAR + M15 SWING HIGH + M1 FVG BEAR")
